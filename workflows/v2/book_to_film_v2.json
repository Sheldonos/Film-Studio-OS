{
  "schema_version": "2.0",
  "workflow_id": "book_to_film_v2",
  "version": "2.0.0",
  "description": "End-to-end licensed book adaptation through release-ready dry-run production.",
  "production_route": "provider_neutral",
  "steps": [
    {
      "id": "ingest",
      "capability_id": "source_ingestion",
      "owner_agent": "production_librarian",
      "reviewer_agent": "security_data_governance",
      "output_type": "SourceIngest",
      "handler": "artifact"
    },
    {
      "id": "diagnose",
      "capability_id": "production_readiness_diagnostic",
      "owner_agent": "studio_orchestrator",
      "reviewer_agent": "line_producer",
      "depends_on": [
        "ingest"
      ],
      "output_type": "ProductionReadinessDiagnostic",
      "handler": "project_diagnostic"
    },

    {
      "id": "rights",
      "capability_id": "rights_risk_triage",
      "owner_agent": "rights_clearance_supervisor",
      "reviewer_agent": "line_producer",
      "depends_on": [
        "diagnose"
      ],
      "output_type": "RightsGate",
      "handler": "rights_gate",
      "approval_required": true,
      "approval_role": "human_rights_owner",
      "gate_id": "adaptation_rights"
    },
    {
      "id": "adapt",
      "capability_id": "adaptation_mandate",
      "owner_agent": "adaptation_executive",
      "reviewer_agent": "script_editor",
      "depends_on": [
        "rights"
      ],
      "output_type": "AdaptationMandate",
      "handler": "artifact"
    },
    {
      "id": "script",
      "capability_id": "scene_writing",
      "owner_agent": "showrunner",
      "reviewer_agent": "script_editor",
      "depends_on": [
        "adapt"
      ],
      "output_type": "Screenplay",
      "handler": "artifact"
    },
    {
      "id": "team",
      "capability_id": "production_role_coverage",
      "owner_agent": "line_producer",
      "reviewer_agent": "qc_supervisor",
      "depends_on": [
        "script"
      ],
      "output_type": "ProductionTeamContributionPlan",
      "handler": "team_plan"
    },
    {
      "id": "shots",
      "capability_id": "shot_spec_compilation",
      "owner_agent": "director",
      "reviewer_agent": "cinematographer",
      "depends_on": [
        "team"
      ],
      "output_type": "ShotPackage",
      "handler": "artifact"
    },
    {
      "id": "generate",
      "capability_id": "video_generation_plan",
      "owner_agent": "generative_supervisor",
      "reviewer_agent": "qc_supervisor",
      "depends_on": [
        "shots"
      ],
      "output_type": "GeneratedTake",
      "handler": "mock_generation"
    },
    {
      "id": "finish",
      "capability_id": "master_qc",
      "owner_agent": "qc_supervisor",
      "reviewer_agent": "studio_orchestrator",
      "depends_on": [
        "generate"
      ],
      "output_type": "MasterQC",
      "handler": "gate",
      "approval_required": true,
      "approval_role": "human_release_owner",
      "gate_id": "release_approval"
    }
  ]
}
