{
  "$defs": {
    "ArtifactStatus": {
      "enum": [
        "draft",
        "review",
        "approved",
        "locked",
        "stale",
        "superseded",
        "rejected"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "description": "Page, paragraph, timecode, chapter, or stable source locator",
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "quote_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Hash"
        },
        "schema_version": {
          "default": "2.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_id": {
          "minLength": 1,
          "title": "Source Asset Id",
          "type": "string"
        }
      },
      "required": [
        "source_asset_id",
        "locator"
      ],
      "title": "SourceCitation",
      "type": "object"
    }
  },
  "$id": "https://film-studio-os.local/schemas/v2/ArtifactVersion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "locked_invariants": {
      "items": {
        "type": "string"
      },
      "title": "Locked Invariants",
      "type": "array"
    },
    "parent_version_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Version Ids",
      "type": "array"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_citations": {
      "items": {
        "$ref": "#/$defs/SourceCitation"
      },
      "title": "Source Citations",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ArtifactStatus",
      "default": "draft"
    },
    "uri": {
      "default": "",
      "title": "Uri",
      "type": "string"
    },
    "version_id": {
      "minLength": 1,
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "version_id",
    "project_id",
    "artifact_type",
    "content_hash",
    "created_by"
  ],
  "title": "ArtifactVersion",
  "type": "object"
}
