{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "note_id": {
      "minLength": 1,
      "title": "Note Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "author": {
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "kind": {
      "enum": [
        "diagnosis",
        "revision_proposal",
        "question",
        "risk",
        "approval_comment"
      ],
      "title": "Kind",
      "type": "string"
    },
    "severity": {
      "default": "info",
      "enum": [
        "info",
        "minor",
        "major",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "note_id",
    "project_id",
    "subject_id",
    "author",
    "kind",
    "text"
  ],
  "title": "Note",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/Note.json"
}
