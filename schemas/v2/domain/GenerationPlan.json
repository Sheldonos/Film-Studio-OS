{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generation_plan_id": {
      "minLength": 1,
      "title": "Generation Plan Id",
      "type": "string"
    },
    "shot_id": {
      "minLength": 1,
      "title": "Shot Id",
      "type": "string"
    },
    "strategy": {
      "enum": [
        "image",
        "video",
        "2d",
        "3d",
        "hybrid",
        "traditional"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "adapter_capability_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Adapter Capability Requirements",
      "type": "array"
    },
    "reference_artifact_version_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reference Artifact Version Ids",
      "type": "array"
    },
    "max_attempts": {
      "default": 3,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "cost_budget_usd": {
      "default": 0,
      "minimum": 0,
      "title": "Cost Budget Usd",
      "type": "number"
    },
    "fallback_strategy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Strategy"
    }
  },
  "required": [
    "generation_plan_id",
    "shot_id",
    "strategy"
  ],
  "title": "GenerationPlan",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/GenerationPlan.json"
}
