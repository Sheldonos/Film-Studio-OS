{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_id": {
      "minLength": 1,
      "title": "Shot Id",
      "type": "string"
    },
    "scene_id": {
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "shot_spec_version_id": {
      "minLength": 1,
      "title": "Shot Spec Version Id",
      "type": "string"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "ready",
        "generating",
        "review",
        "selected",
        "rejected",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "take_ids": {
      "items": {
        "type": "string"
      },
      "title": "Take Ids",
      "type": "array"
    },
    "selected_take_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Take Id"
    }
  },
  "required": [
    "shot_id",
    "scene_id",
    "shot_spec_version_id"
  ],
  "title": "Shot",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/Shot.json"
}
