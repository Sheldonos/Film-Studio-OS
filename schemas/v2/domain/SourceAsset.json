{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "minLength": 1,
      "title": "Source Asset Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "source_kind": {
      "enum": [
        "book",
        "script",
        "draft",
        "treatment",
        "bible",
        "research",
        "interview",
        "storyboard",
        "concept_art",
        "video",
        "audio",
        "image",
        "transcript",
        "caption",
        "other"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "rights_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Rights Record Ids",
      "type": "array"
    },
    "security_findings": {
      "items": {
        "type": "string"
      },
      "title": "Security Findings",
      "type": "array"
    }
  },
  "required": [
    "source_asset_id",
    "project_id",
    "filename",
    "media_type",
    "sha256",
    "source_kind"
  ],
  "title": "SourceAsset",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/SourceAsset.json"
}
