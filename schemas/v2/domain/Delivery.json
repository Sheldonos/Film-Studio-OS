{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "delivery_id": {
      "minLength": 1,
      "title": "Delivery Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "delivery_spec_id": {
      "minLength": 1,
      "title": "Delivery Spec Id",
      "type": "string"
    },
    "master_artifact_version_ids": {
      "items": {
        "type": "string"
      },
      "title": "Master Artifact Version Ids",
      "type": "array"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "qc",
        "approval",
        "released",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "delivery_id",
    "project_id",
    "target",
    "delivery_spec_id"
  ],
  "title": "Delivery",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/Delivery.json"
}
