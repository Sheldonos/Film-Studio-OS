{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "season_id": {
      "minLength": 1,
      "title": "Season Id",
      "type": "string"
    },
    "production_id": {
      "minLength": 1,
      "title": "Production Id",
      "type": "string"
    },
    "season_number": {
      "minimum": 1,
      "title": "Season Number",
      "type": "integer"
    },
    "episode_ids": {
      "items": {
        "type": "string"
      },
      "title": "Episode Ids",
      "type": "array"
    },
    "arc_summary": {
      "default": "",
      "title": "Arc Summary",
      "type": "string"
    }
  },
  "required": [
    "season_id",
    "production_id",
    "season_number"
  ],
  "title": "Season",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/Season.json"
}
