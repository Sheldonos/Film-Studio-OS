{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "take_id": {
      "minLength": 1,
      "title": "Take Id",
      "type": "string"
    },
    "shot_id": {
      "minLength": 1,
      "title": "Shot Id",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "artifact_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Version Id"
    },
    "status": {
      "default": "generated",
      "enum": [
        "generated",
        "review",
        "selected",
        "rejected",
        "repair"
      ],
      "title": "Status",
      "type": "string"
    },
    "qc_gate_result_ids": {
      "items": {
        "type": "string"
      },
      "title": "Qc Gate Result Ids",
      "type": "array"
    }
  },
  "required": [
    "take_id",
    "shot_id",
    "attempt_id"
  ],
  "title": "Take",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/Take.json"
}
