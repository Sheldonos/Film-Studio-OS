      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "format": {
      "minLength": 1,
      "title": "Format",
      "type": "string"
    },
    "audience": {
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "quality_bar": {
      "minLength": 1,
