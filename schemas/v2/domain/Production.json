{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "production_id": {
      "minLength": 1,
      "title": "Production Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "production_route": {
      "enum": [
        "fully_generative",
        "generative_post",
        "2d_assisted",
        "3d_dcc_assisted",
        "previs_only",
        "hybrid_live_animation",
        "documentary"
      ],
      "title": "Production Route",
      "type": "string"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "active",
        "paused",
        "locked",
        "delivered",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "budget_usd": {
      "default": 0,
      "minimum": 0,
      "title": "Budget Usd",
      "type": "number"
    }
  },
  "required": [
    "production_id",
    "project_id",
    "production_route"
  ],
  "title": "Production",
  "type": "object",
  "$id": "https://film-studio-os.local/schema/v2/domain/Production.json"
}
