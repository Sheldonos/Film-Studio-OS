{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected",
        "revoked"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    }
  },
  "$id": "https://film-studio-os.local/schemas/v2/ConsentRecord.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consent_id": {
      "minLength": 1,
      "title": "Consent Id",
      "type": "string"
    },
    "digital_replica": {
      "default": false,
      "title": "Digital Replica",
      "type": "boolean"
    },
    "evidence_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Artifact Ids",
      "type": "array"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "intended_use_description": {
      "default": "",
      "title": "Intended Use Description",
      "type": "string"
    },
    "likeness": {
      "default": false,
      "title": "Likeness",
      "type": "boolean"
    },
    "person_or_entity": {
      "minLength": 1,
      "title": "Person Or Entity",
      "type": "string"
    },
    "revocable": {
      "default": true,
      "title": "Revocable",
      "type": "boolean"
    },
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "pending"
    },
    "voice_clone": {
      "default": false,
      "title": "Voice Clone",
      "type": "boolean"
    }
  },
  "required": [
    "consent_id",
    "person_or_entity",
    "scope"
  ],
  "title": "ConsentRecord",
  "type": "object"
}
