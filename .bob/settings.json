{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .bob/hooks/session_context.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^execute_command$",
        "hooks": [
          {
            "type": "command",
            "command": "python .bob/hooks/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
